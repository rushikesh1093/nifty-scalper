# Copy this to .env and fill in your credentials
APP_NAME=Nifty Scalper
DEBUG=true
ENVIRONMENT=development

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_pg_password
POSTGRES_DB=nifty_scalper

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=

NIFTY_TOKEN=26000
BANKNIFTY_TOKEN=26009

# Backtest page (read API + launcher). All optional.
# REPLAY_DATABASE_URL is the replay result store (async SQLAlchemy URL, e.g.
# sqlite+aiosqlite:///C:/path/replay.db). It must NOT point at nifty_scalper
# (the paper-trading database): such a URL is refused. Never returned by any endpoint.
REPLAY_DATABASE_URL=
# Generated synthetic datasets; empty -> <system temp>/nifty-replay-datasets
REPLAY_DATASET_DIR=
REPLAY_JOB_TIMEOUT_S=1800
REPLAY_DATASET_TIMEOUT_S=600
REPLAY_JOB_HISTORY=20
BACKTEST_SYNTHETIC_MAX_DAYS=60
BACKTEST_MAX_ARTIFACT_FILES=200
BACKTEST_MAX_LAUNCH_RANGE_DAYS=90
